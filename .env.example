# Phase 1 does not load this file. `make publish` reads it and does not
# override variables that are already set in the environment.
# Leave every value commented. Do not put real secrets here.
#
# Phase 1 and Phase 2 read OLLAMA_HOST and OLLAMA_MODEL from the process
# environment when they are set. Otherwise they use edu/config/niche.yaml.
# Fact check uses the same model as script generation.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Instagram Graph API. Live publish stays a dry-run until these exist.
# IG_APP_ID=
# IG_APP_SECRET=
# IG_ACCESS_TOKEN=
# IG_USER_ID=
# IG_TOKEN_EXPIRES_AT=
# IG_GRAPH_VERSION=v21.0

# YouTube Data API v3. The refresh token can also live in edu/out/youtube_token.json.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# Public mp4 host for the Instagram video_url. VIDEO_HOST is r2 or supabase.
# Dry-run does not upload. The object is deleted after a live publish.
# VIDEO_HOST=
# Cloudflare R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_PUBLIC_BASE=

# Supabase Storage
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=
